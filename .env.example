# Copy to .env on the server and fill in real values. Never commit .env.

# Hostname Caddy will request a TLS certificate for.
DOMAIN=trace.example.com

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Signs the QR verification tokens. Generate with: openssl rand -hex 32
# WARNING: changing this after QR labels have been printed invalidates
# every existing code. Set it once and keep it.
SECRET_KEY=
